# Netlify → Site settings → Environment variables
# The assistant calls /api/chat, which forwards to the model provider with this
# key attached server-side. It is never shipped to the browser.
UPSTREAM_KEY=

# Optional overrides
UPSTREAM_URL=https://api-sf1-cdn.deploy.com/api/v1/chat/completions
UPSTREAM_MODEL=zai-org/glm-5.3-flash

# 'low' keeps answers fast (reasoning is hidden either way). 'none' makes the
# model leak its deliberation into the reply, so leave this on low.
UPSTREAM_REASONING=low
